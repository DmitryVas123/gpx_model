<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic planned route as <rte> only, integer elevation, no timestamps,
     one waypoint, and a Cyrillic name. -->
<gpx version="1.1" creator="alpha-tests" xmlns="http://www.topografix.com/GPX/1/1">
  <wpt lat="46.0010" lon="8.0"><name>Hut</name></wpt>
  <rte>
    <name>Маршрут к хижине</name>
    <rtept lat="46.0000" lon="8.0"><ele>1000</ele></rtept>
    <rtept lat="46.0005" lon="8.0"><ele>1020</ele></rtept>
    <rtept lat="46.0010" lon="8.0"><ele>1050</ele></rtept>
  </rte>
</gpx>
