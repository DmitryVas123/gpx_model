# --- Personal data (never commit) ---
data/local/
*.db
*.sqlite
*.sqlite3

# Every GPX is personal except the synthetic test fixtures.
*.gpx
!tests/fixtures/**/*.gpx

# --- Secrets ---
.env
.env.*
!.env.example

# --- Documentation site (generated; sources: build/site_src) ---
site/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# --- Tool caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- IDE ---
.idea/
.vscode/

# --- Exploration output ---
*.html
!docs/**/*.html
# The local web page is source code, not output.
!src/alpha/api/static/*.html
