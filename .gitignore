# --- Personal data (never commit) ---
data/local/
*.db
*.sqlite
*.sqlite3

# Any GPX outside the shareable locations is treated as personal.
*.gpx
!data/samples/*.gpx
!tests/fixtures/**/*.gpx

# --- Secrets ---
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# --- Tool caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- IDE ---
.idea/
.vscode/

# --- Exploration output ---
*.html
!docs/**/*.html
